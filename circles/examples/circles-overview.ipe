<text transformations="translations" pos="55 630" stroke="ink" type="label" width="292.281" height="11.953" depth="3.35" valign="baseline">\textsf{\LARGE\bfseries Every tangent circle. One click away.}</text>
<text transformations="translations" pos="55 598" stroke="muted" type="label" width="339.92" height="6.926" depth="1.93" valign="baseline">\textsf{Preview every exact candidate, point to one, and create native editable geometry.}</text>
<text transformations="translations" pos="70 525" stroke="ink" type="label" width="145.831" height="8.302" depth="0" valign="baseline">\textsf{\large\bfseries 1\enspace Preview all 8 candidates}</text>
<text transformations="translations" pos="70 497" stroke="muted" type="label" width="179.632" height="6.926" depth="1.93" valign="baseline">\textsf{Move the pointer to highlight any solution.}</text>
<text transformations="translations" pos="650 525" stroke="ink" type="label" width="117.427" height="8.302" depth="0" valign="baseline">\textsf{\large\bfseries 2\enspace Click to create one}</text>
<text transformations="translations" pos="650 497" stroke="muted" type="label" width="183.423" height="6.926" depth="1.93" valign="baseline">\textsf{The chosen result stays fully editable in Ipe.}</text>
<text transformations="translations" pos="70 68" stroke="muted" type="label" width="151.477" height="6.926" depth="1.93" valign="baseline">\textsf{\bfseries Blue: inputs\qquad Red: candidates}</text>
<text transformations="translations" pos="650 68" stroke="muted" type="label" width="169.175" height="6.926" depth="1.93" valign="baseline">\textsf{\bfseries Blue: inputs\qquad Black: chosen circle}</text>
